{
  "functions": [
    {
      "source": "node",
      "codebase": "node",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run lint"
      ]
    },
    {
      "source": "python",
      "codebase": "python",
      "runtime": "python314",
      "ignore": [
        "venv",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local",
        "__pycache__"
      ]
    }
  ],
  "hosting": {
    "public": "hosting/public",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/respondToEvent",
        "function": { "functionId": "respondToEvent", "region": "us-central1" }
      },
      {
        "source": "/appCheckToken",
        "function": { "functionId": "appCheckToken", "region": "us-central1" }
      },
      {
        "source": "/sendVerificationEmail",
        "function": {
          "functionId": "sendVerificationEmail",
          "region": "us-central1"
        }
      },
      {
        "source": "/forgotPassword",
        "function": { "functionId": "forgotPassword", "region": "us-central1" }
      },
      {
        "source": "/signUp",
        "function": { "functionId": "signUp", "region": "us-central1" }
      },
      {
        "source": "/incrementUserCount",
        "function": {
          "functionId": "incrementUserCount",
          "region": "us-central1"
        }
      },
      {
        "source": "/incrementEventCount",
        "function": {
          "functionId": "incrementEventCount",
          "region": "us-central1"
        }
      },
      {
        "source": "/searchUsers",
        "function": { "functionId": "searchUsers", "region": "us-central1" }
      },
      {
        "source": "/searchPlaces",
        "function": { "functionId": "searchPlaces", "region": "us-central1" }
      },
      {
        "source": "/getPlaceDetails",
        "function": {
          "functionId": "getPlaceDetails",
          "region": "us-central1"
        }
      }
    ]
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
